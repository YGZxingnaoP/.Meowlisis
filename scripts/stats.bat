@echo off
chcp 65001 >nul
setlocal
set "ROOT=%~dp0.."
set "PY=%ROOT%\runtime\311\python.exe"
if not exist "%PY%" set "PY=python"
set "WORK=%TEMP%\meow_stats_%RANDOM%%RANDOM%"
mkdir "%WORK%" 2>nul
set "B64=%WORK%\stats.b64"
if exist "%B64%" del /q "%B64%"
>> "%B64%" echo 
>> "%B64%" echo 
>> "%B64%" echo 
>> "%B64%" echo 
>> "%B64%" echo 
>> "%B64%" echo 
>> "%B64%" echo 
powershell -NoProfile -NonInteractive -Command "$s = Get-Content -Raw $env:B64; $p = Join-Path $env:WORK 'stats.py'; [IO.File]::WriteAllBytes($p, [Convert]::FromBase64String($s))"
"%PY%" -X utf8 "%WORK%\stats.py" "%ROOT%"
del /q "%WORK%\stats.py" "%B64%" 2>nul
rd /q "%WORK%" 2>nul
echo.
pause
